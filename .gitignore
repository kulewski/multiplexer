# Bazel convenience symlinks and outputs
bazel-*
# make (see Makefile)
/build/
# Python
__pycache__/
*.pyc
# Editors
*.swp
*~
# bazel run //compdb (clangd)
/compile_commands.json
/external
/.cache/
# Editor state
/.vscode/
# The tools ./format.sh fetches on first use (ruff)
/.tools/

# The examples: the virtual environments their test.sh scripts make
# (examples/.venv shared by the examples workflow, and made by
# examples/venv.sh for check.sh), and the logs and process ids their steps
# write; anything else an example writes, its own .gitignore names.
examples/.venv
examples/*/.venv
examples/*/*.log
examples/*/*.pid
