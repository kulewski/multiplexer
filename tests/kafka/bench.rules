# vim:ft=conf:

# The system rules: the peer and message types the multiplexer, the
# libraries and mxcontrol use themselves. Every rules file starts from this
# one, which `mxcontrol generate_rules FILE` writes, and adds the
# deployment's own types after it, numbered 100 and up, apart from the
# entries below that use that range: peer types 108 and 111 and message
# types 112 to 115. A deployment may also edit its copy, to send LOGS_STREAM
# to a log collector of its own as well, say. docs/rules.md describes the
# format.

# Peer types 1 to 99 belong to the protocol.

peer {
    type: 1
    name: "MULTIPLEXER"
    comment: "Peer type representing normal multiplexer instance."
}

peer {
    type: 2
    name: "ALL_TYPES"
    comment: "this is special peer type that causes a message to be sent to all types"
}

peer {
    type: 99
    name: "MAX_MULTIPLEXER_SPECIAL_PEER_TYPE"
    comment: "this only defines a constant"
}

# Log streaming: what `mxcontrol streamlogs` connects as, sending the log
# entries of the Python library's log streaming, and what `mxcontrol
# receivelogs` connects as, printing them.

peer {
    type: 108
    name: "LOG_STREAMER"
}

peer {
    type: 111
    name: "LOG_RECEIVER_EXAMPLE"
}

# Message types 1 to 99 belong to the protocol.

type {
    type: 1
    name: "PING"
    comment: "I'm alive packet; it never carries any significant message."
}

type {
    type: 2
    name: "CONNECTION_WELCOME"
    comment: "message interchange by peers just after connecting to each other"
}

type {
    type: 3
    name: "BACKEND_FOR_PACKET_SEARCH"
    comment: "message used by MX client in query() for finding a backend that would handle its request"
}

type {
    type: 4
    name: "HEARTBIT"
    comment: "packet to be sent by every peer on every channel when nothing sent through the given channel for certain period of time"
}

type {
    type: 5
    name: "DELIVERY_ERROR"
    comment: "packet could not be delivered to one or more recipients"
}

type {
    type: 6
    name: "RECORDING_CONTROL"
    comment: "a peer asks a multiplexer to start, stop or report its recording, or to tap in; payload is RecordingControl"
}

type {
    type: 7
    name: "RECORDING_STATUS"
    comment: "the multiplexer's answer to RECORDING_CONTROL; payload is RecordingStatus"
}

type {
    type: 8
    name: "RECORDING_RECORD"
    comment: "one Record streamed to a peer that tapped in"
}
type {
    type: 9
    name: "RULES_CONTROL"
    comment: "a peer asks a multiplexer to read its rules file again, or which rules it has in use; payload is RulesControl"
}
type {
    type: 10
    name: "RULES_STATUS"
    comment: "the multiplexer's answer to RULES_CONTROL; payload is RulesStatus"
}
type {
    type: 11
    name: "PEER_CONTROL"
    comment: "a peer tells a multiplexer which routing reaches it from now on; payload is PeerControl"
}
type {
    type: 12
    name: "PEER_STATUS"
    comment: "the multiplexer's answer to PEER_CONTROL; payload is PeerStatus"
}

type {
    type: 13
    name: "CONFIRMATION"
    comment: "a consumer's library tells a producer which of its confirmed records were processed, refused or failed; payload is Confirmation"
}

type {
    type: 99
    name: "MAX_MULTIPLEXER_META_PACKET"
    comment: "this only defines a constant"
}

# The replies the server classes send besides the caller's own, addressed
# to the requester, which is why they need no rule.

type {
    type: 112
    name: "PICKLE_RESPONSE"
    comment: "a reply whose payload is a pickled Python object, which send_pickle() and reply_pickle() send by default"
}

type {
    type: 113
    name: "REQUEST_RECEIVED"
    comment: "packet sent by the backend immediately after receiving a request and straight to the requesting peer"
}

type {
    type: 114
    name: "BACKEND_ERROR"
    comment: "packet sent by the backend when request handling function finishes and no response packet is sent"
}

# Log streaming: the log entries `mxcontrol streamlogs` sends, to every
# receiver.

type {
    type: 115
    name: "LOGS_STREAM"
    comment: "payload is LogEntriesMessage"
    to {
        peer: "LOG_RECEIVER_EXAMPLE"
        whom: ALL
    }
}

# The Kafka comparison's own types (docs/kafka.md, tests/kafka/run.sh): the
# producers send BENCH_RECORD events, and each goes to one consumer, in
# turn, as a Kafka consumer group shares a topic's partitions. The
# producers and consumers run on SyncClient, so they are passive, but for
# producers on ThreadedClient (`mx_bench produce --client threaded`),
# whose io thread runs all the time, active. A consumer may hold a
# million messages at the multiplexer, records or batches of them, before
# it drops any, so that a burst a consumer falls behind on is held, as
# Kafka holds its log, rather than dropped; a run says when records were
# dropped all the same.

peer {
    type: 200
    name: "BENCH_PRODUCER"
    is_passive: true
}

peer {
    type: 202
    name: "BENCH_THREADED_PRODUCER"
}

peer {
    type: 201
    name: "BENCH_CONSUMER"
    queue_size: 1048576
    is_passive: true
}

type {
    type: 200
    name: "BENCH_RECORD"
    comment: "a record; its first 8 bytes are the steady clock, in ns, at its send"
    to {
        peer: "BENCH_CONSUMER"
        whom: ANY
    }
}
