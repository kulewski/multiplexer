# A plain `bazel build //...` works. The configs only change optimisation and
# debug info.
build --cxxopt=-std=c++17

# The repository's own builds generate the package's constants from the
# tests' rules file, the system rules plus the types the tests use; a
# consumer of @mx never reads this file and gets the system rules, and the
# release names them for what it publishes.
build --//:multiplexer_rules=//tests:testing.rules

# Warnings are errors for our own code and the generated protobuf sources.
# External code is compiled silently and its headers are system headers, so
# nothing in Asio, pybind11 or zstd can fail a build. One-off escape hatch:
#   bazel build --per_file_copt=.*@-Wno-error //...
build --copt=-Wall
build --copt=-Wextra
build --features=external_include_paths
build --per_file_copt=external/.*@-w
build --per_file_copt=.*,-external/.*@-Werror

build:debug -c dbg

build:release -c opt
# -c opt passes -g0; keep symbols so the *_with_debug_symbols binaries stay
# debuggable (cores, perf). maybe_strip produces the stripped copies we ship.
build:release --copt=-g

# Every test on a network of its own, a loopback and nothing else, where
# Bazel's linux-sandbox can make one: tests running at once never take each
# other's ports, the one a restarted multiplexer binds again included.
# multiplexer/testing/private_network_test.py says whether it holds.
test --sandbox_default_allow_network=false

# Sanitizers. asan also switches the generate_constants tool (see
# multiplexer/BUILD); tsan finds data races the annotations cannot.
build:asan --//:is_asan=true --copt=-fsanitize=address --linkopt=-fsanitize=address
build:tsan --copt=-fsanitize=thread --linkopt=-fsanitize=thread -c dbg
# gcc warns about libstdc++ fences it cannot instrument; not our code.
build:tsan --copt=-Wno-tsan
# A sanitized test runs several times slower than a plain one, and a loaded
# machine slows it further: under either sanitizer a small test has 300 s,
# where it has 60 s otherwise.
test:asan --test_timeout=300,300,900,3600
test:tsan --test_timeout=300,300,900,3600

# Static thread-safety analysis (lib/thread_annotations.h) needs clang.
# Uses the installed clang-18; everything else stays the same.
build:clang --repo_env=CC=clang-18
build:clang --copt=-Wthread-safety
# clang warns about K&R definitions in zlib even under -w; nothing to do about it.
build:clang --per_file_copt=external/.*@-Wno-deprecated-non-prototype
